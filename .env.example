FLASK_CONFIG=development
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters-long
DATABASE_URL=sqlite:///canteen.db

# Number of trusted reverse proxies (0 locally; set based on known deployment topology).
TRUSTED_PROXY_COUNT=0
# Local only. Production must use shared storage, for example redis://host:6379/0.
RATELIMIT_STORAGE_URI=memory://

# Hosts menu item images may be loaded from (comma-separated, exact hostnames, https only).
MENU_IMAGE_ALLOWED_HOSTS=images.unsplash.com

# Server-side sessions. Privileged (admin/kitchen) sessions expire quickly.
SESSION_IDLE_MINUTES_PRIVILEGED=30
SESSION_ABSOLUTE_HOURS_PRIVILEGED=8
SESSION_IDLE_MINUTES_STUDENT=720
SESSION_ABSOLUTE_HOURS_STUDENT=168

# Administrator two-factor authentication.
MFA_PENDING_MINUTES=5
MFA_MAX_FAILED_ATTEMPTS=5
MFA_LOCKOUT_MINUTES=15

# Set to true to log CSP violations without blocking them (useful when first rolling out).
CSP_REPORT_ONLY=false

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional Firebase Admin SDK; never commit the service-account JSON file.
FIREBASE_ENABLED=false
FIREBASE_DATABASE_URL=
FIREBASE_SERVICE_ACCOUNT_PATH=serviceAccountKey.json

ORDER_PAYMENT_EXPIRY_MINUTES=10
COLLECTION_TOKEN_EXPIRY_MINUTES=60
CANTEEN_UTC_OFFSET_MINUTES=330

# Password-recovery email. Development uses console (codes are written to the log only).
# Production must use smtp; see render.yaml.
MAIL_BACKEND=console
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_USE_TLS=true
